# Esempio per sviluppo: valori reali solo nel .env privato del server.
# In produzione: APP_ENV=production, APP_DEBUG=false, APP_URL=https://dominio.
APP_NAME=ZeroMagazzino
APP_ENV=local
APP_KEY=
# Chiavi precedenti solo per rotazione pianificata; mai rigenerare APP_KEY al deploy.
APP_PREVIOUS_KEYS=
# Solo prima installazione cPanel senza CLI; eliminare dopo uso. Vuoto = installer 404.
ZERO_INSTALL_TOKEN=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zeromagazzino
DB_USERNAME=
DB_PASSWORD=
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# CA verificata, se il database remoto richiede TLS.
MYSQL_ATTR_SSL_CA=
# Solo servizio Docker locale; non necessario sul server gestito/cPanel.
MYSQL_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Il default è true in produzione; impostare false solo per HTTP locale.
# SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
# Namespace distinto se più installazioni condividono la cache.
# CACHE_PREFIX=
BROADCAST_CONNECTION=log

QUEUE_CONNECTION=database
INTEGRATIONS_QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=null
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
# Maggiore di timeout worker (45s) e lease integrazioni (120s).
DB_QUEUE_RETRY_AFTER=150
QUEUE_FAILED_DRIVER=database-uuids
# Queue Redis opzionale, se scelta e disponibile sul server.
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=150
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Le foto usano comunque il disco local privato; FILESYSTEM_DISK non le sposta su S3.
FILESYSTEM_DISK=local
INVENTORY_IMAGE_BINARY=/usr/bin/convert
# S3 è opzionale e non configurato come storage delle foto delle giacenze.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=null
AWS_ENDPOINT=null
AWS_USE_PATH_STYLE_ENDPOINT=false

# Solo sviluppo: il mailer log scrive i link di reset nei log privati.
# Produzione: MAIL_MAILER=smtp e dati del fornitore; usare TLS verificato.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_URL=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# MAIL_EHLO_DOMAIN=mail.example.com
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SENDMAIL_PATH="/usr/sbin/sendmail -bs -i"
MAIL_LOG_CHANNEL=null

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

STORE_DRIVER=fake
# Firma del solo adapter fake. Ogni provider reale definirà le proprie variabili.
STORE_WEBHOOK_SECRET=

PRIVACY_POLICY_URL=
PRIVACY_POLICY_VERSION=availability-v1
CREDIT_MATURATION_DAYS=0
VITE_APP_NAME="${APP_NAME}"
